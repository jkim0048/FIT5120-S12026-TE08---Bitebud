{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "icons:ingest": "tsx src/jobs/ingestWicked.ts",
    "icons:list": "tsx src/jobs/listWickedIcons.ts",
    "icons:spotcheck": "tsx src/jobs/spotCheckIconMatching.ts",
    "recipes:backfill-images": "dotenv -e ../.env -- tsx src/jobs/backfillRecipeImages.ts",
    "recipes:backfill-meta": "dotenv -e ../.env -- tsx src/jobs/backfillRecipeMetadata.ts",
    "icons:clear-poisoned-maps": "dotenv -e ../.env -- tsx src/jobs/clearPoisonedIconMap.ts",
    "recipes:wipe-mealdb-cache": "dotenv -e ../.env -- tsx src/jobs/wipeMealDbCache.ts",
    "sensory:backfill": "dotenv -e ../.env -- tsx src/jobs/backfillSensoryFoodItems.ts",
    "prisma:generate": "dotenv -e ../.env -- prisma generate",
    "prisma:studio": "dotenv -e ../.env -- prisma studio",
    "prisma:migrate": "dotenv -e ../.env -- prisma migrate dev",
    "prisma:deploy": "dotenv -e ../.env -- prisma migrate deploy"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "5.22.0",
    "dotenv": "^17.4.1",
    "fastify": "^5.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "dotenv-cli": "^11.0.0",
    "prisma": "5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
