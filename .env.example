# Copy this file to `.env` in the repo root (next to README.md).
# Used by: `npm run prisma:deploy --prefix backend`, backend `dotenv -e ../.env`, etc.
#
# Do not commit `.env` (it is gitignored).

# Pooler (IPv4-friendly) and direct connection — use your Supabase (or other Postgres) URLs.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?schema=public&sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public&sslmode=require"

# Optional for local API features
# GEMINI_API_KEY=
